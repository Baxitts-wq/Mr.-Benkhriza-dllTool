<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="[ BENKHRIZA'S STEAM CONTROL SYSTEM v3.0 ]"
        Width="820" Height="870"
        MinWidth="780" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        Background="#000000"
        AllowDrop="True"
        Opacity="1.0">

    <Window.Resources>
        <Style x:Key="LogStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="0,1"/>
        </Style>
        
        <Style x:Key="HackerTab" TargetType="TabItem">
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Background" Value="#0D0D14"/>
            <Setter Property="Foreground" Value="#666677"/>
            <Setter Property="BorderBrush" Value="#222233"/>
            <Setter Property="Padding" Value="14,7"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#12121F"/>
                    <Setter Property="Foreground" Value="#00FF41"/>
                    <Setter Property="BorderBrush" Value="#00FF41"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="#00CC00"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        
        <Style x:Key="HackerBtn" TargetType="Button">
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="#0B0B12"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid RenderTransformOrigin="0.5,0.5">
                            <Border x:Name="wave1" CornerRadius="4" BorderThickness="2"
                                    BorderBrush="{TemplateBinding BorderBrush}" Background="Transparent"
                                    Opacity="0" RenderTransformOrigin="0.5,0.5" IsHitTestVisible="False">
                                <Border.RenderTransform>
                                    <ScaleTransform x:Name="wave1Scale" ScaleX="1.0" ScaleY="1.0"/>
                                </Border.RenderTransform>
                            </Border>
                            <Border x:Name="wave2" CornerRadius="4" BorderThickness="1.5"
                                    BorderBrush="{TemplateBinding BorderBrush}" Background="Transparent"
                                    Opacity="0" RenderTransformOrigin="0.5,0.5" IsHitTestVisible="False">
                                <Border.RenderTransform>
                                    <ScaleTransform x:Name="wave2Scale" ScaleX="1.0" ScaleY="1.0"/>
                                </Border.RenderTransform>
                            </Border>
                            <Border x:Name="border"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="4" RenderTransformOrigin="0.5,0.5">
                                <Border.RenderTransform>
                                    <ScaleTransform x:Name="scale" ScaleX="1.0" ScaleY="1.0"/>
                                </Border.RenderTransform>
                                <Border.Effect>
                                    <DropShadowEffect x:Name="glow" Color="{Binding BorderBrush.Color, RelativeSource={RelativeSource TemplatedParent}}" BlurRadius="0" ShadowDepth="0" Opacity="0"/>
                                </Border.Effect>
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="glow" Storyboard.TargetProperty="BlurRadius" To="18" Duration="0:0:0.2"/>
                                            <DoubleAnimation Storyboard.TargetName="glow" Storyboard.TargetProperty="Opacity" To="0.9" Duration="0:0:0.2"/>
                                            <DoubleAnimation Storyboard.TargetName="scale" Storyboard.TargetProperty="ScaleX" To="1.02" Duration="0:0:0.15"/>
                                            <DoubleAnimation Storyboard.TargetName="scale" Storyboard.TargetProperty="ScaleY" To="1.02" Duration="0:0:0.15"/>
                                            <ColorAnimation Storyboard.TargetName="border" Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)" To="#161624" Duration="0:0:0.2"/>
                                            <DoubleAnimation Storyboard.TargetName="wave1Scale" Storyboard.TargetProperty="ScaleX" From="1.0" To="1.7" Duration="0:0:0.9" RepeatBehavior="Forever"/>
                                            <DoubleAnimation Storyboard.TargetName="wave1Scale" Storyboard.TargetProperty="ScaleY" From="1.0" To="1.7" Duration="0:0:0.9" RepeatBehavior="Forever"/>
                                            <DoubleAnimation Storyboard.TargetName="wave1" Storyboard.TargetProperty="Opacity" From="0.7" To="0" Duration="0:0:0.9" RepeatBehavior="Forever"/>
                                            <DoubleAnimation Storyboard.TargetName="wave2Scale" Storyboard.TargetProperty="ScaleX" From="1.0" To="1.7" Duration="0:0:0.9" BeginTime="0:0:0.45" RepeatBehavior="Forever"/>
                                            <DoubleAnimation Storyboard.TargetName="wave2Scale" Storyboard.TargetProperty="ScaleY" From="1.0" To="1.7" Duration="0:0:0.9" BeginTime="0:0:0.45" RepeatBehavior="Forever"/>
                                            <DoubleAnimation Storyboard.TargetName="wave2" Storyboard.TargetProperty="Opacity" From="0.7" To="0" Duration="0:0:0.9" BeginTime="0:0:0.45" RepeatBehavior="Forever"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="glow" Storyboard.TargetProperty="BlurRadius" To="0" Duration="0:0:0.2"/>
                                            <DoubleAnimation Storyboard.TargetName="glow" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2"/>
                                            <DoubleAnimation Storyboard.TargetName="scale" Storyboard.TargetProperty="ScaleX" To="1.0" Duration="0:0:0.15"/>
                                            <DoubleAnimation Storyboard.TargetName="scale" Storyboard.TargetProperty="ScaleY" To="1.0" Duration="0:0:0.15"/>
                                            <ColorAnimation Storyboard.TargetName="border" Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)" To="#0B0B12" Duration="0:0:0.2"/>
                                            <DoubleAnimation Storyboard.TargetName="wave1" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.1"/>
                                            <DoubleAnimation Storyboard.TargetName="wave2" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.1"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#222238"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="HackerList" TargetType="ListBox">
            <Setter Property="Background" Value="#050508"/>
            <Setter Property="BorderBrush" Value="#00FF41"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>

        <Style TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="#00FF41"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Background" Value="Transparent"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#00FF41"/>
                    <Setter Property="Foreground" Value="#000000"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#0D260D"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="OrangeListBoxItem" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="#FF9900"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Background" Value="Transparent"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#FF9900"/>
                    <Setter Property="Foreground" Value="#000000"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#261A0D"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Custom Dark ScrollBar Style -->
        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="#050508"/>
            <Setter Property="Foreground" Value="#00FF41"/>
            <Setter Property="Width" Value="10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid x:Name="Bg" Background="#050508">
                            <Track x:Name="PART_Track" IsDirectionReversed="true">
                                <Track.Thumb>
                                    <Thumb Background="#00FF41">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="{TemplateBinding Background}" CornerRadius="2"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Custom Dark ComboBox Style -->
        <Style x:Key="HackerComboBox" TargetType="ComboBox">
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#00FF41"/>
            <Setter Property="Background" Value="#05050C"/>
            <Setter Property="BorderBrush" Value="#00FF41"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton"
                                          Focusable="false"
                                          IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="Border"
                                                Background="#0B0B12"
                                                BorderBrush="#00FF41"
                                                BorderThickness="1"
                                                CornerRadius="3">
                                            <Grid HorizontalAlignment="Right" Width="20">
                                                <Path x:Name="Arrow"
                                                      Fill="#00FF41"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"
                                                      Data="M 0 0 L 4 4 L 8 0 Z"/>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Border" Property="Background" Value="#161624"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter x:Name="ContentSite"
                                              IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              Margin="8,4,24,4"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Left"/>
                            <Popup x:Name="Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Slide">
                                <Grid x:Name="DropDown"
                                      SnapsToDevicePixels="True"
                                      MinWidth="{TemplateBinding ActualWidth}"
                                      MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <Border x:Name="DropDownBorder"
                                            Background="#090912"
                                            BorderBrush="#00FF41"
                                            BorderThickness="1"
                                            CornerRadius="3"/>
                                    <ScrollViewer Margin="4" SnapsToDevicePixels="True">
                                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Grid>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Foreground" Value="#00FF41"/>
                        <Setter Property="Background" Value="#05050C"/>
                        <Setter Property="FontFamily" Value="Consolas"/>
                        <Setter Property="FontSize" Value="11"/>
                        <Setter Property="Padding" Value="6,4"/>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#161624"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#00FF41"/>
                                <Setter Property="Foreground" Value="#000000"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Custom Dark CheckBox Style -->
        <Style TargetType="CheckBox">
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Foreground" Value="#FF9900"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border x:Name="Box" Width="14" Height="14" Background="#0B0B12" BorderBrush="#FF9900" BorderThickness="1" CornerRadius="2" Margin="0,0,6,0">
                                <Path x:Name="CheckMark" Data="M 2 6 L 5 9 L 11 3" Stroke="#FF9900" StrokeThickness="2" Visibility="Collapsed"/>
                            </Border>
                            <ContentPresenter VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="#1A140A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Window.Triggers>
        <EventTrigger RoutedEvent="Window.Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                     From="0" To="1" Duration="0:0:0.6"/>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>

    <Border BorderBrush="#00FF41" BorderThickness="2" Margin="6" Background="#07070B">
        <Grid Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Unified Header Card -->
                <RowDefinition Height="*"/>    <!-- Main Content TabControl -->
                <RowDefinition Height="130"/>  <!-- System Terminal Log -->
                <RowDefinition Height="Auto"/> <!-- Global Action Bar -->
                <RowDefinition Height="Auto"/> <!-- Credits Footer -->
            </Grid.RowDefinitions>

            <!-- Main Matrix Background Rain Canvas -->
            <Canvas x:Name="MainMatrixRain" Background="Transparent" Grid.RowSpan="5" ClipToBounds="True" IsHitTestVisible="False" Opacity="0.2"/>

            <!-- Fine falling particle dust layer -->
            <Canvas x:Name="ParticleRain" Background="Transparent" Grid.RowSpan="5" ClipToBounds="True" IsHitTestVisible="False"/>

            <!-- Green click-flash overlay -->
            <Border x:Name="ClickFlash" Background="#00FF41" Grid.RowSpan="5" Opacity="0" IsHitTestVisible="False" Panel.ZIndex="90"/>

            <!-- Cyberpunk Boot Splash Overlay -->
            <Grid x:Name="BootOverlay" Background="#07070B" Panel.ZIndex="100" Grid.RowSpan="5">
                <Canvas x:Name="BootMatrixRain" Background="Transparent" ClipToBounds="True"/>
                <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Logo Row -->
                        <RowDefinition Height="Auto"/> <!-- Text/Progress Row -->
                    </Grid.RowDefinitions>
                    
                    <!-- Boot Splash Logo (Dominant 220px Emblem) -->
                    <Border Grid.Row="0" CornerRadius="110" Width="220" Height="220"
                            HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,20" Opacity="0" x:Name="BootLogoBorder">
                        <Border.Effect>
                            <DropShadowEffect x:Name="BootLogoGlow" Color="#FF003C" BlurRadius="45" ShadowDepth="0" Opacity="0.95"/>
                        </Border.Effect>
                        <Border.Triggers>
                            <EventTrigger RoutedEvent="Border.Loaded">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.8"/>
                                        <DoubleAnimation Storyboard.TargetName="BootLogoGlow" Storyboard.TargetProperty="BlurRadius" From="20" To="55" Duration="0:0:1.0" AutoReverse="True" RepeatBehavior="Forever"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Border.Triggers>
                        <Border CornerRadius="110" ClipToBounds="True">
                            <Image x:Name="BootLogoImage" Stretch="UniformToFill"/>
                        </Border>
                    </Border>

                    <!-- Boot Info Block -->
                    <StackPanel Grid.Row="1" HorizontalAlignment="Center">
                        <TextBlock Text="[ BENKHRIZA STEAM CONTROL SYSTEM v3.0 ]" FontFamily="Consolas" FontSize="13" FontWeight="Bold" Foreground="#FF003C" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                        <TextBlock x:Name="BootSplashText" FontFamily="Consolas" FontSize="13" FontWeight="Bold"
                                   Foreground="#00FF41" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,0,0,12"/>
                        <ProgressBar IsIndeterminate="True" Height="3" Width="240" Foreground="#00FF41" Background="#111111" BorderThickness="0" HorizontalAlignment="Center"/>
                        
                        <!-- Cyberpunk Loader Spinner -->
                        <Border Width="22" Height="22" CornerRadius="11" BorderThickness="2.5,0,2.5,2.5" BorderBrush="#00FF41" Margin="0,10,0,0" HorizontalAlignment="Center">
                            <Border.RenderTransform>
                                <RotateTransform x:Name="SpinnerRotate" Angle="0" CenterX="11" CenterY="11"/>
                            </Border.RenderTransform>
                            <Border.Triggers>
                                <EventTrigger RoutedEvent="Border.Loaded">
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="SpinnerRotate" Storyboard.TargetProperty="Angle" From="0" To="360" Duration="0:0:1.0" RepeatBehavior="Forever"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </Border.Triggers>
                        </Border>
                    </StackPanel>
                </Grid>
            </Grid>

            <!-- UNIFIED HEADER CARD (Dominant Hacker Emblem Display) -->
            <Border Grid.Row="0" BorderBrush="#00FF41" BorderThickness="1.5" Background="#0C0C16" Padding="14,10" Margin="0,0,0,8">
                <StackPanel HorizontalAlignment="Center">
                    <!-- Header Logo: Layered Pulsing Neon Aura & Rotating Multi-Rings -->
                    <Grid Width="190" Height="190" Margin="0,0,0,8" HorizontalAlignment="Center">
                        <!-- Matrix Green Outer Pulse Aura -->
                        <Border CornerRadius="95" Width="188" Height="188" BorderThickness="1"
                                BorderBrush="#00FF41" Background="Transparent"
                                HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Border.Effect>
                                <DropShadowEffect Color="#00FF41" BlurRadius="25" ShadowDepth="0" Opacity="0.5"/>
                            </Border.Effect>
                        </Border>
                        
                        <!-- Slow Crimson Outer Ring -->
                        <Border CornerRadius="90" Width="180" Height="180" BorderThickness="2"
                                BorderBrush="#FF003C" Background="Transparent"
                                HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Border.Effect>
                                <DropShadowEffect x:Name="LogoGlowSlow" Color="#FF003C" BlurRadius="35" ShadowDepth="0" Opacity="0.6"/>
                            </Border.Effect>
                            <Border.Triggers>
                                <EventTrigger RoutedEvent="Border.Loaded">
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="LogoGlowSlow" Storyboard.TargetProperty="BlurRadius" From="20" To="48" Duration="0:0:2.4" AutoReverse="True" RepeatBehavior="Forever"/>
                                            <DoubleAnimation Storyboard.TargetName="LogoGlowSlow" Storyboard.TargetProperty="Opacity" From="0.4" To="0.85" Duration="0:0:2.4" AutoReverse="True" RepeatBehavior="Forever"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </Border.Triggers>
                        </Border>
                        
                        <!-- Fast Inner Ring -->
                        <Border CornerRadius="81" Width="162" Height="162" BorderThickness="1.5"
                                BorderBrush="#FF003C" Background="Transparent"
                                HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Border.Effect>
                                <DropShadowEffect x:Name="LogoGlowFast" Color="#FF003C" BlurRadius="20" ShadowDepth="0" Opacity="0.7"/>
                            </Border.Effect>
                            <Border.Triggers>
                                <EventTrigger RoutedEvent="Border.Loaded">
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="LogoGlowFast" Storyboard.TargetProperty="BlurRadius" From="10" To="30" Duration="0:0:0.7" AutoReverse="True" RepeatBehavior="Forever"/>
                                            <DoubleAnimation Storyboard.TargetName="LogoGlowFast" Storyboard.TargetProperty="Opacity" From="0.4" To="0.95" Duration="0:0:0.7" AutoReverse="True" RepeatBehavior="Forever"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </Border.Triggers>
                        </Border>
                        
                        <!-- Main Emblem Container with Deep Neon Shadow -->
                        <Border CornerRadius="75" Width="150" Height="150"
                                HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Border.Effect>
                                <DropShadowEffect x:Name="LogoGlow" Color="#FF003C" BlurRadius="40" ShadowDepth="0" Opacity="0.95"/>
                            </Border.Effect>
                            <Border.Triggers>
                                <EventTrigger RoutedEvent="Border.Loaded">
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="LogoGlow" Storyboard.TargetProperty="BlurRadius" From="20" To="50" Duration="0:0:1.3" AutoReverse="True" RepeatBehavior="Forever"/>
                                            <DoubleAnimation Storyboard.TargetName="LogoGlow" Storyboard.TargetProperty="Opacity" From="0.6" To="1.0" Duration="0:0:1.3" AutoReverse="True" RepeatBehavior="Forever"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </Border.Triggers>
                            <Border CornerRadius="75" ClipToBounds="True">
                                <Image x:Name="LogoImage" Stretch="UniformToFill"/>
                            </Border>
                        </Border>
                    </Grid>

                    <!-- System Info Details -->
                    <TextBlock Text="[ BENKHRIZA STEAM CONTROL SYSTEM v3.0 ]" FontFamily="Consolas" FontSize="14" FontWeight="Bold" Foreground="#FF003C" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                    
                    <Grid Width="500" HorizontalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="&gt; OPERATOR: Benkhriza" FontFamily="Consolas" FontSize="10" Foreground="#00FF41" Margin="0,1"/>
                            <TextBlock Text="&gt; ENGINE: OPENSTEAMTOOL v3.0" FontFamily="Consolas" FontSize="10" Foreground="#00FF41" Margin="0,1"/>
                        </StackPanel>
                        
                        <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                            <TextBlock x:Name="BypassStatusText" Text="&gt; BYPASS: ACTIVE &amp; STABLE" FontFamily="Consolas" FontSize="10" Foreground="#FF3333" Margin="0,1" HorizontalAlignment="Right">
                                <TextBlock.Triggers>
                                    <EventTrigger RoutedEvent="TextBlock.Loaded">
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1.0" To="0.2" Duration="0:0:0.7" AutoReverse="True" RepeatBehavior="Forever"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </TextBlock.Triggers>
                            </TextBlock>
                            <TextBlock x:Name="DbCountLabel" Text="&gt; DB: 0 GAMES LOADED" FontFamily="Consolas" FontSize="10" Foreground="#00FF41" Margin="0,1" HorizontalAlignment="Right"/>
                        </StackPanel>
                    </Grid>
                    <TextBlock x:Name="BootPathLog" FontFamily="Consolas" FontSize="9" Foreground="#555566" Margin="0,2,0,0" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </Border>

            <!-- MAIN CONTENT TAB CONTROL -->
            <TabControl Grid.Row="1" Background="#000000" BorderBrush="#00FF41" BorderThickness="1" Margin="0,0,0,8">
                <TabControl.Resources>
                    <Style TargetType="TabPanel">
                        <Setter Property="Background" Value="#07070B"/>
                    </Style>
                </TabControl.Resources>

                <!-- TAB 1: LOCAL DATABASE -->
                <TabItem Header="[ LOCAL DATABASE ]" Style="{StaticResource HackerTab}">
                    <Border Background="#050508" Padding="10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Local Search Box -->
                            <Grid Grid.Row="0" Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="FILTER CATALOG: " FontFamily="Consolas" FontSize="11" FontWeight="Bold"
                                           Foreground="#FF003C" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBox x:Name="SearchBox" Grid.Column="1" Height="28"
                                         Background="#0B0B12" Foreground="#00FF41"
                                         BorderBrush="#00FF41" BorderThickness="1"
                                         FontFamily="Consolas" FontSize="11"
                                         Padding="6,4" VerticalContentAlignment="Center"
                                         CaretBrush="#00FF41"/>
                            </Grid>

                            <!-- Local Game List -->
                            <ListBox x:Name="GameList" Grid.Row="1" Style="{StaticResource HackerList}" MinHeight="180"/>

                            <!-- Local Action Buttons -->
                            <Grid Grid.Row="2" Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button x:Name="InjectBtn" Grid.Column="0"
                                        Content="[ INJECT LUA ]"
                                        Style="{StaticResource HackerBtn}"
                                        Height="32" Margin="0,0,4,0"
                                        Foreground="#00FF41" BorderBrush="#00FF41" FontSize="10"/>
                                <Button x:Name="InjectOnlineFixBtn" Grid.Column="1"
                                        Content="[ INJECT ONLINEFIX ]"
                                        Style="{StaticResource HackerBtn}"
                                        Height="32" Margin="2,0,4,0"
                                        Foreground="#FF9900" BorderBrush="#FF9900" FontSize="10"/>
                                <CheckBox x:Name="OnlineFixChk" Grid.Column="2"
                                          Content="OnlineFix Flag"
                                          Margin="4,0,8,0"
                                          VerticalAlignment="Center"/>
                                <Button x:Name="SyncBtn" Grid.Column="3"
                                        Content="[ SYNC BACKUP ]"
                                        Style="{StaticResource HackerBtn}"
                                        Height="32" Margin="2,0,0,0"
                                        Foreground="#FF9900" BorderBrush="#FF9900" FontSize="10"/>
                            </Grid>
                        </Grid>
                    </Border>
                </TabItem>

                <!-- TAB 2: STEAM ONLINE SEARCH -->
                <TabItem Header="[ SEARCH STEAM STORE ]" Style="{StaticResource HackerTab}">
                    <Border Background="#050508" Padding="10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Steam Search Input -->
                            <Grid Grid.Row="0" Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="SteamSearchBox" Grid.Column="0" Height="28"
                                         Background="#0B0B12" Foreground="#FF9900"
                                         BorderBrush="#FF9900" BorderThickness="1"
                                         FontFamily="Consolas" FontSize="11"
                                         Padding="6,4" VerticalContentAlignment="Center"
                                         CaretBrush="#FF9900"
                                         Tag="Type a game name and press SEARCH..."/>
                                <Button x:Name="SteamSearchBtn" Grid.Column="1"
                                        Content="[ SEARCH ]"
                                        Style="{StaticResource HackerBtn}"
                                        Height="28" Width="95" Margin="6,0,0,0"
                                        Foreground="#FF9900" BorderBrush="#FF9900" FontSize="10"/>
                            </Grid>

                            <!-- Steam Search Results -->
                            <ListBox x:Name="SteamResultList" Grid.Row="1"
                                     Style="{StaticResource HackerList}"
                                     ItemContainerStyle="{StaticResource OrangeListBoxItem}"
                                     BorderBrush="#FF9900" MinHeight="160"/>

                            <!-- Selected game info bar -->
                            <Border Grid.Row="2" Background="#0E0902" BorderBrush="#FF9900"
                                    BorderThickness="1" Padding="8,6" Margin="0,6,0,6">
                                <TextBlock x:Name="SteamGameInfo"
                                           Text="&gt; Select a game from the results above"
                                           FontFamily="Consolas" FontSize="10"
                                           Foreground="#FF9900" TextWrapping="Wrap"/>
                            </Border>

                            <!-- Download Action Buttons -->
                            <Grid Grid.Row="3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button x:Name="FetchLuaBtn" Grid.Column="0"
                                        Content="[ FETCH REAL LUA (BROWSER) ]"
                                        Style="{StaticResource HackerBtn}"
                                        Height="32" Margin="0,0,4,0"
                                        Foreground="#00FF41" BorderBrush="#00FF41" FontSize="10"/>
                                <Button x:Name="OpenSteamDbBtn" Grid.Column="1"
                                        Content="[ OPEN ON STEAMDB ]"
                                        Style="{StaticResource HackerBtn}"
                                        Height="32" Margin="4,0,0,0"
                                        Foreground="#4A9EFF" BorderBrush="#4A9EFF" FontSize="10"/>
                            </Grid>
                        </Grid>
                    </Border>
                </TabItem>
            </TabControl>

            <!-- SYSTEM TERMINAL LOG CONSOLE -->
            <Border Grid.Row="2" Background="#050508" BorderBrush="#00FF41"
                    BorderThickness="1" Padding="8,6" Margin="0,0,0,8" Height="130">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="[ SYSTEM TERMINAL LOGS ]" FontFamily="Consolas" FontSize="10" FontWeight="Bold" Foreground="#00FF41" Margin="0,0,0,4"/>
                    <ScrollViewer x:Name="LogScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="LogPanel">
                            <TextBlock x:Name="BootPathLog2" Style="{StaticResource LogStyle}" Foreground="#555566"/>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- GLOBAL ACTION BAR -->
            <Grid Grid.Row="3" Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="270"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="SONG:" FontFamily="Consolas" FontSize="11" Foreground="#00FF41" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <ComboBox x:Name="MusicTrackList" Grid.Column="1"
                          Width="260" Height="34" Margin="0,0,6,0"
                          Style="{StaticResource HackerComboBox}"
                          ToolTip="Select a song from the Songs folder"
                          IsEditable="False"/>
                <Button x:Name="BrowseBtn" Grid.Column="2"
                        Content="[ IMPORT LUA FILES MANUALLY ]"
                        Style="{StaticResource HackerBtn}"
                        Height="34" Margin="0,0,6,0"
                        Foreground="#00FF41" BorderBrush="#00FF41" FontSize="11"/>
                <Button x:Name="ClearBtn" Grid.Column="3"
                        Content="[ CLEAR TERMINAL LOG ]"
                        Style="{StaticResource HackerBtn}"
                        Height="34" Margin="0,0,6,0"
                        Foreground="#FF003C" BorderBrush="#FF003C" FontSize="11"/>
                <Button x:Name="PauseMusicBtn" Grid.Column="4"
                        Content="[ || ]"
                        Style="{StaticResource HackerBtn}"
                        Height="34" Width="56"
                        Foreground="#00FF41" BorderBrush="#00FF41" FontSize="11"
                        ToolTip="Toggle ambient audio"/>
            </Grid>

            <!-- CREDITS FOOTER -->
            <DockPanel Grid.Row="4" Margin="0,2,0,0">
                <TextBlock Text="CRACKED &amp; CODED BY: BENKHRIZA" FontFamily="Consolas"
                           FontSize="10" FontWeight="Bold" Foreground="#FF003C" DockPanel.Dock="Left"/>
                <TextBlock Text="Benkhriza" FontFamily="Consolas" FontSize="10"
                           Foreground="#444455" DockPanel.Dock="Right" HorizontalAlignment="Right"/>
            </DockPanel>

            <MediaElement x:Name="BackgroundAudio" LoadedBehavior="Manual" UnloadedBehavior="Stop" Visibility="Collapsed"/>
        </Grid>
    </Border>
</Window>
